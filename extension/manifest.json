{
  "manifest_version": 3,
  "name": "Proofread",
  "version": "0.1.0",
  "description": "Correct grammar and rewrite text in any text box, using a free opencode model running on your own machine.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Proofread options"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "shared.js",
        "content.js"
      ],
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "correct-grammar": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Correct grammar in the focused text box"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
